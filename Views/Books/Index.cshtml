@model List<Book>
@{
    ViewData["Title"] = "Books";
    var cats = (List<string>)ViewBag.Categories;
    var isAdmin = User.IsInRole("Admin");
}
<div class="d-flex justify-content-between mb-3">
    <h2>Books</h2>
    @if (isAdmin) { <a class="btn btn-primary align-self-center" asp-action="Create">+ Add book</a> }
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search title, author or ISBN" /></div>
    <div class="col-md-3">
        <select name="category" class="form-select">
            <option value="">All categories</option>
            @foreach (var c in cats) { <option value="@c" selected="@(c == (string?)ViewBag.Category)">@c</option> }
        </select>
    </div>
    <div class="col"><button class="btn btn-secondary">Search</button></div>
</form>
<table class="table table-striped bg-white align-middle">
    <thead><tr><th>Title</th><th>Author</th><th>ISBN</th><th>Category</th><th>Shelf</th><th>Available</th>@if (isAdmin) { <th></th> }</tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.Title</td><td>@b.Author</td><td>@b.Isbn</td><td>@b.Category</td><td>@b.ShelfLocation</td>
            <td><span class="badge @(b.AvailableCopies > 0 ? "bg-success" : "bg-danger")">@b.AvailableCopies / @b.TotalCopies</span></td>
            @if (isAdmin)
            {
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this book?')">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            }
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-muted">No books found.</p> }
