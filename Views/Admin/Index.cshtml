@model DashboardVm
@inject LibraryService Lib
@{
    ViewData["Title"] = "Dashboard";
    var cards = new (string Label, string Value, string Css)[]
    {
        ("Titles", Model.Titles.ToString(), "primary"),
        ("Copies available", $"{Model.Available} / {Model.Copies}", "success"),
        ("Members", Model.Members.ToString(), "info"),
        ("Active loans", Model.ActiveLoans.ToString(), "dark"),
        ("Overdue", Model.Overdue.Count.ToString(), "danger"),
        ("Fines outstanding", "₱" + Model.FinesOutstanding.ToString("N2"), "warning"),
        ("Fines collected", "₱" + Model.FinesCollected.ToString("N2"), "secondary")
    };
}
<h2 class="mb-3">Admin dashboard</h2>
<div class="row g-3 mb-4">
    @foreach (var c in cards)
    {
        <div class="col-6 col-md-3"><div class="card border-@c.Css"><div class="card-body"><div class="text-muted small">@c.Label</div><div class="fs-4 fw-semibold">@c.Value</div></div></div></div>
    }
</div>
<h4>Overdue books</h4>
<table class="table table-striped bg-white">
    <thead><tr><th>Book</th><th>Member</th><th>Due</th><th>Days late</th><th>Accrued fine</th></tr></thead>
    <tbody>
    @foreach (var l in Model.Overdue)
    {
        <tr><td>@l.Book.Title</td><td>@l.User.FullName</td><td>@l.DueOn.ToString("MMM d, yyyy")</td><td>@l.OverdueDays</td><td>₱@Lib.Fine(l).ToString("N2")</td></tr>
    }
    </tbody>
</table>
@if (!Model.Overdue.Any()) { <p class="text-muted">Nothing overdue 🎉</p> }
