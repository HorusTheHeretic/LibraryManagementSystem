<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">📚 Library</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <ul class="navbar-nav me-auto">
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                }
                <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Index">Books</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Loans" asp-action="Index">Loans</a></li>
                @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Loans" asp-action="Issue">Issue</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users">Members</a></li>
                }
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Report">Reports</a></li>
                }
            </ul>
            <span class="navbar-text me-3">@User.Identity.Name (@User.FindFirst(ClaimTypes.Role)?.Value)</span>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light">Logout</button></form>
        }
        else
        {
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
            </ul>
        }
    </div>
</nav>
<main class="container pb-5">
    @if (TempData["Msg"] is string m) { <div class="alert alert-success">@m</div> }
    @if (TempData["Err"] is string e) { <div class="alert alert-danger">@e</div> }
    @RenderBody()
</main>
</body>
</html>
